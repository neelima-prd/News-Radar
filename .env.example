# ====================================================================
# NEWS RADAR - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your actual keys.
# ====================================================================

# --------------------------------------------------------------------
# PUBLIC / FRONTEND SAFE (Exposed in client browser bundle via Vite)
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# --------------------------------------------------------------------
# SERVER ONLY / SECRET (NEVER send or expose to client browser)
# --------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@newsradar.local
CRON_SECRET=your-cron-secret-token
